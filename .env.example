# MiniMax (LLM / embeddings when enabled)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Supabase project ref (Dashboard → Settings → General) — used by: pnpm db:link <ref>
# SUPABASE_PROJECT_REF=

# Supabase (server / workers — never prefix service key with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Supabase (browser — must match SUPABASE_URL / SUPABASE_ANON_KEY above)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp (Baileys) — Kairo agent
WA_SESSION_PATH=./agents/kairo/src/baileys/session

# Job polling
LINKEDIN_GUEST_API_BASE=https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search
POLLING_INTERVAL_MS=900000
MATCH_SCORE_THRESHOLD=70

# Web (Next.js)
NEXT_PUBLIC_APP_URL=

# CV pipeline (Railway apps/cv-pipeline + Edge Functions)
RENDERCV_THEME=EngineeringResumes
CV_PIPELINE_URL=http://127.0.0.1:3100
CV_PIPELINE_SECRET=
SUPABASE_AUTH_HOOK_SECRET=

# Edge Functions (set via: pnpm exec supabase secrets set ...)
# MINIMAX_API_KEY is shared with poller/Kairo
MINIMAX_MODEL=MiniMax-Text-01
